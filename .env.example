# ============================================================
# AI Slop Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Required ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-pro-preview

# --- Slack (leave blank to disable the bot) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Channel IDs to auto-scan (comma-separated, leave blank to disable)
SLACK_AUTO_SCAN_CHANNELS=
# Minimum score to trigger an auto-scan alert (0–100)
AUTO_SCAN_THRESHOLD=70

# --- App ---
RUBRIC_PATH=rubric.yaml
# Comma-separated allowed origins for the web UI
CORS_ORIGINS=http://localhost:5173
PORT=8080
